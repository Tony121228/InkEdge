PORT=3000
APP_SECRET=replace-with-at-least-32-random-characters
# Optional for HTTPS development; production always enables Secure cookies.
COOKIE_SECURE=

AI_API_BASE_URL=
# 例如：https://api.deepseek.com/v1 或供应商提供的 Base URL
AI_API_KEY=
# 在本地或部署环境的 Secret 管理里设置，不要提交到仓库
AI_DETECT_MODEL=
# 例如：deepseek-chat 或其他模型名
AI_REWRITE_MODEL=
# 例如：deepseek-chat 或其他模型名

# Optional HTTP proxy
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# Bootstrap admin mailboxes, comma separated. Full addresses are matched exactly.
ADMIN_EMAILS=admin@example.com

# Email verification via SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=墨锋InkEdge <noreply@example.com>
SMTP_CLIENT_NAME=localhost

# Fixed WeChat personal business payment QR shown on account page.
WECHAT_PAY_QR_SRC=/assets/wechat-merchant-qr.svg
WECHAT_PAY_PAYEE=微信个人经营收款码
